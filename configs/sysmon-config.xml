<Sysmon schemaversion="4.82">
  <HashAlgorithms>SHA256</HashAlgorithms>
  <EventFiltering>
    <!-- Event ID 1: Process Create -->
    <!-- Log all process creation events -->
    <ProcessCreate onmatch="exclude">
    </ProcessCreate>

    <!-- Event ID 3: Network Connection -->
    <RuleGroup name="Network Exclusions" groupRelation="or">
        <NetworkConnect onmatch="exclude">

            <!-- Exclude network connections initiated by mitmproxy -->
            <Rule groupRelation="and">
                <Image condition="is">C:\Program Files\mitmproxy\bin\mitmweb.exe</Image>
            </Rule>

            <!-- Exclude standard DNS traffic -->
            <Rule groupRelation="and">
                <DestinationPort condition="is">53</DestinationPort>
            </Rule>

            <!-- Exclude mDNS traffic -->
            <Rule groupRelation="and">
                <DestinationPort condition="is">5353</DestinationPort>
            </Rule>

            <!-- Exclude LLMNR traffic -->
            <Rule groupRelation="and">
                <DestinationPort condition="is">5355</DestinationPort>
            </Rule>

            <!-- Exclude local connections to mitmproxy -->
            <Rule groupRelation="and">
                <DestinationIp condition="is">127.0.0.1</DestinationIp>
                <DestinationPort condition="is">8080</DestinationPort>
            </Rule>
        </NetworkConnect>
    </RuleGroup>

    <!-- Event ID 22: DNS Query -->
    <!-- Log all DNS query events -->
    <DnsQuery onmatch="exclude">
    </DnsQuery>
    
    <!-- Exclude file creation events generated by log_monitor_lab(the folder used for lab) to reduce false positives -->
    <FileCreate onmatch="exclude">
        <TargetFilename condition="begin with">C:\Users\<user_account_name>\Desktop\log_monitor_lab\data\</TargetFilename>
    </FileCreate>

    <!-- Collect only selected registry events to reduce noise (additional rules may be added in the future) -->
    <RegistryEvent onmatch="include">
      <TargetObject condition="contains">\Software\Microsoft\Windows\CurrentVersion\Run</TargetObject>
    </RegistryEvent>

    <!-- Event ID 26: Exclude file deletion events generated by log_monitor_lab to reduce false positives -->
    <FileDeleteDetected onmatch="exclude">
      <TargetFilename condition="begin with">C:\Users\vn55c\Desktop\log_monitor_lab\data\</TargetFilename>
    </FileDeleteDetected>

  </EventFiltering>
</Sysmon>
